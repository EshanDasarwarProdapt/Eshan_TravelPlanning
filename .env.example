# =====================================================================
# WAYPOINT: AI-Powered Travel Planning & Itinerary Assistant Config
# =====================================================================

# AI Credits (OpenAI-compatible chat API)
LLM_API_KEY=your_aicredits_key_here
LLM_BASE_URL=https://aicredits.in/v1
LLM_MODEL=gpt-5-nano

# Unused while LLM_API_KEY is set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vector Store & Embedding Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=travel_reviews_uci_485
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Recommendation & Scoring Weights
WEIGHT_PREFERENCE_MATCH=0.30
WEIGHT_SEMANTIC_RELEVANCE=0.25
WEIGHT_RATING=0.20
WEIGHT_EVIDENCE_STRENGTH=0.15
WEIGHT_BUDGET_COMPATIBILITY=0.10

# Multi-Agent Guardrails & Quality
QUALITY_THRESHOLD=0.80
MAX_REFINEMENT_LOOPS=2
